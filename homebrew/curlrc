# Homebrew 専用の curl 設定（HOMEBREW_CURLRC で読み込ませる）
#
# 受信が 15 秒間 1000 bytes/sec を下回ったら打ち切り、Homebrew のリトライに任せる。
# Homebrew の bottle / cask ダウンロードには無通信タイムアウトがなく、
# IPv4 経路の不調で接続が固まると brew upgrade が無期限に止まるため。
speed-limit = 1000
speed-time = 15

# 失敗した転送だけを curl_errors.log に追記する（標準出力には何も出さない）。
# Homebrew 自身が --write-out を渡す呼び出しではそちらが優先され、記録されない。
# macOS 標準の curl (8.7.x) は %time{} 非対応のため時刻は _brew 側で付与する。
variable = "%HOME"
expand-write-out = "%output{>>{{HOME}}/.cache/Homebrew/Logs/curl_errors.log}%{onerror}exit=%{exitcode} http=%{http_code} ip=%{remote_ip} bytes=%{size_download} url=%{url} error=%{errormsg}\n"
