{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LC_TIME=ja_JP.UTF-8 date '+現在日時: %Y-%m-%d (%a) %H:%M %Z'"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/nvim-follow.sh mark"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nvim-follow.sh open"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nvim-follow.sh view"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nvim-follow.sh sync"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "theme": "dark-ansi",
  "tui": "fullscreen"
}
